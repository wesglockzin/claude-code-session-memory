# Required (no defaults): the tool exits at startup naming the missing one.
# Ollama base URL, for example http://<host>:<port>
OLLAMA_HOST=
# Embedding model name as known to Ollama
SESSION_MEMORY_MODEL=

# Optional
# Directory of *.md memory files (default: ~/.claude/memory)
CLAUDE_MEMORY_DIR=
# Where the index and logs live (default: ~/.claude/session-memory)
SESSION_MEMORY_STATE=
# Comma-separated basenames to skip (default: MEMORY.md)
SESSION_MEMORY_EXCLUDE=
